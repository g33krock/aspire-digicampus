# Supabase - get these from your Supabase project dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database - get these from Supabase dashboard > Settings > Database
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
DB_DATABASE=postgres

# Set to false once your schema is stable
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Set to false if using a local Postgres without SSL
DB_SSL=true

# Server port (must match the proxy in client/package.json which is 5000)
PORT=5000
